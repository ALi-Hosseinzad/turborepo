{
  "extends": "tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@constants/*": ["./src/constants/*"],
      "@views/*": ["./src/views/*"],
      "@configs/*": ["./src/configs/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@libs/*": ["./src/libs/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "./src/**/*.tsx",
    "./src/**/*.ts",
    ".next/types/**/*.ts",
    "../../packages/ui/*"
  ],
  "exclude": ["node_modules"],
  "noImplicitAny": true,
  "noImplicitThis": true,
  "strictNullChecks": true
}
