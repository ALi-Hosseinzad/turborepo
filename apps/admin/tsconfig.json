{
  "extends": "tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": "./src"
  },
  "include": [
    ".",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "./src/**/*.tsx",
    "./src/**/*.ts",
    ".next/types/**/*.ts",
    "../../packages/ui/types/buttonInterface.tsx"
  ],
  "exclude": ["node_modules"],
  "noImplicitAny": true,
  "noImplicitThis": true,
  "strictNullChecks": true
}
