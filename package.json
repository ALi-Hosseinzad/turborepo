{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:admin": "turbo run build --scope=admin",
    "build:client": "turbo run build --scope=client",
    "build:web": "turbo run build --scope=web",
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --scope=admin",
    "dev:client": "turbo run dev --scope=client",
    "dev:web": "turbo run dev --scope=web",
    "lint:admin": "turbo run lint --scope=admin",
    "lint:client": "turbo run lint --scope=client",
    "lint:web": "turbo run lint --scope=web",
    "lint:ui": "turbo run lint --scope=ui",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "test": "turbo run lint",
    "lint:format": "turbo run lint & prettier & tsc --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@ostigan-tailwind/configs": "*",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/js-cookie": "^3.0.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.48.0",
    "eslint-config-custom": "*",
    "eslint-plugin-custom": "*",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.2",
    "postcss-nesting": "^12.1.5",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.3.5",
    "tsconfig": "*",
    "turbo": "^1.11.3"
  },
  "name": "my-turborepo",
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "apps/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.1",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.17",
    "@mui/material-nextjs": "^5.15.11",
    "@mui/styled-engine-sc": "^6.0.0-alpha.5",
    "@mui/x-date-pickers": "^6.18.0",
    "@tanstack/query-core": "^5.8.2",
    "@tanstack/react-query": "^5.8.2",
    "@tanstack/react-query-devtools": "^5.8.2",
    "@types/stylis": "^4.2.4",
    "axios": "^1.6.1",
    "date-fns-jalali": "^2.30.0-0",
    "dayjs": "^1.11.11",
    "formik": "^2.4.5",
    "iconsax-react": "^0.0.8",
    "jalali-moment": "^3.3.11",
    "js-cookie": "^3.0.5",
    "jss-rtl": "^0.3.0",
    "next": "^13.5.6",
    "next-intl": "^3.4.2",
    "next-themes": "^0.2.1",
    "react-quill": "^2.0.0",
    "react-toastify": "^9.1.3",
    "stylis": "^4.3.0",
    "stylis-plugin-rtl": "^2.1.1",
    "yarn": "^1.22.19",
    "yup": "^1.3.2"
  }
}
